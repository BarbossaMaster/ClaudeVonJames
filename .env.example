# Copie para .env e preencha. Só ANTHROPIC_API_KEY e JARVIS_TOKEN são necessários para começar.

# --- Cérebro (Claude) ---
ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-opus-5-5

# --- Acesso ao app de voz e à API de eventos (invente uma senha longa) ---
JARVIS_TOKEN=

# --- Identidade ---
ASSISTANT_NAME=Jarvis
OWNER_NAME=
OWNER_TITLE=senhor
BUSINESS_NAME=Astro Gold

# --- Regras iniciais (o dono pode mudar falando com o Jarvis) ---
ESCALATION_THRESHOLD=2000
CURRENCY=BRL
TIMEZONE=America/Sao_Paulo
BRIEFING_HOUR=18

# --- WhatsApp (API oficial da Meta). Sem isto, as mensagens saem no console. ---
# Seu número com DDI, ex.: 5511999998888
OWNER_WHATSAPP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Você inventa; o mesmo valor vai no painel da Meta
WHATSAPP_VERIFY_TOKEN=
# Obrigatório em produção: valida a origem dos webhooks
WHATSAPP_APP_SECRET=
# Template aprovado com 1 variável no corpo, para o resumo sair mesmo se você
# não falou com o Jarvis nas últimas 24h (regra do WhatsApp).
WHATSAPP_BRIEFING_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Opcional: ouvir e responder ÁUDIOS no WhatsApp ---
OPENAI_API_KEY=
# TTS_VOICE=onyx

# PORT=3000
# JARVIS_DB=data/jarvis.db
