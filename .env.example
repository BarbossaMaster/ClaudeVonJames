# Copie para .env e preencha. Só ANTHROPIC_API_KEY e JARVIS_TOKEN são necessários para começar.

# --- Cérebro (Claude) ---
ANTHROPIC_API_KEY=
# Troca automática: conversa comum usa JARVIS_MODEL; assunto importante usa JARVIS_SMART_MODEL.
# JARVIS_SMART_MODEL=claude-opus-5-5
# JARVIS_ROUTER=off   (desliga a troca e usa sempre JARVIS_MODEL)
# Padrão: claude-sonnet-5-5. Para o modelo mais capaz (e mais caro): claude-opus-5-5
# JARVIS_MODEL=claude-sonnet-5-5

# --- Acesso ao app de voz e à API de eventos (invente uma senha longa) ---
JARVIS_TOKEN=

# --- Identidade ---
ASSISTANT_NAME=Jarvis
OWNER_NAME=
OWNER_TITLE=senhor
BUSINESS_NAME=Astro Gold

# --- Regras iniciais (o dono pode mudar falando com o Jarvis) ---
ESCALATION_THRESHOLD=2000
CURRENCY=BRL
TIMEZONE=America/Sao_Paulo
BRIEFING_HOUR=18

# --- WhatsApp (API oficial da Meta). Sem isto, as mensagens saem no console. ---
# Seu número com DDI, ex.: 5511999998888
OWNER_WHATSAPP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Você inventa; o mesmo valor vai no painel da Meta
WHATSAPP_VERIFY_TOKEN=
# Obrigatório em produção: valida a origem dos webhooks
WHATSAPP_APP_SECRET=
# Template aprovado com 1 variável no corpo, para o resumo sair mesmo se você
# não falou com o Jarvis nas últimas 24h (regra do WhatsApp).
WHATSAPP_BRIEFING_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Voz natural (sem isto o app usa a voz robótica do aparelho) ---
# Opção 1, a mais natural: ElevenLabs. Escolha uma voz em elevenlabs.io e copie o Voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Modelo de voz. O padrão, eleven_flash_v2_5, responde mais rápido e gasta metade dos créditos;
# eleven_multilingual_v2 é mais expressivo e mais lento.
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Velocidade da fala no app (1 = normal).
# VOICE_SPEED=1.12
# Profundidade do raciocínio por voz: low, medium (padrão), high, xhigh. Mais alto pensa melhor e demora mais.
# JARVIS_VOICE_EFFORT=high
# Modo rápido do Claude nas conversas por voz (mais veloz, mais caro por resposta).
# JARVIS_FAST=1
# Opção 2: OpenAI. Também é o que permite OUVIR áudios recebidos no WhatsApp.
OPENAI_API_KEY=
# TTS_VOICE=onyx

# PORT=3000
# JARVIS_DB=data/jarvis.db
